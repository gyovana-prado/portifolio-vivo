---
import type { Lang, Now } from '../lib/content';
import { t } from '../lib/content';
import { ui } from '../lib/ui';
import { formatDate } from '../lib/dates';

interface Props {
  lang: Lang;
  now: Now | null;
}

const { lang, now } = Astro.props;
const strings = ui[lang];
---

{now && now.items.length > 0 && (
  <section id="now">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">{strings.nowEyebrow}</div>
        <h2>{strings.nowTitle}</h2>
      </div>
      <p class="lede updated">{strings.nowSnapshot} · {formatDate(now.updated, lang)}</p>
    </div>
    <ul class="now-grid">
      {now.items.map((item) => <li class="reveal">{t(item, lang)}</li>)}
    </ul>
  </section>
)}

<style>
  /* Pulso: a discreet live indicator next to the freshness date. */
  .updated::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    margin-right: 8px;
    vertical-align: 1px;
    animation: pulse 2.8s ease-out infinite;
  }
  .now-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 50px;
  }
  .now-grid li {
    border-top: 1px solid var(--border);
    padding-top: 18px;
    font-size: 0.94rem;
    color: var(--text-dim);
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent); }
    60% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (max-width: 700px) {
    .now-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
