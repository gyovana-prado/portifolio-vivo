---
import type { Lang, Project } from '../lib/content';
import { t } from '../lib/content';
import { ui } from '../lib/ui';
import { md } from '../lib/md';
import { formatYM } from '../lib/dates';

interface Props {
  lang: Lang;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const strings = ui[lang];

// Projects with a problem → decision → evidence story get the large card; the
// rest render as compact rows below them.
const large = projects.filter((p) => p.story);
const compact = projects.filter((p) => !p.story);

function linkLabel(key: string): string {
  if (key === 'repo') return strings.code;
  if (key === 'live') return strings.live;
  return key;
}
---

{projects.length > 0 && (
  <section id="projects">
    <div class="section-head reveal">
      <div>
        <div class="eyebrow">{strings.projectsEyebrow}</div>
        <h2>{strings.projectsTitle}</h2>
      </div>
      <p class="lede">{strings.projectsLede}</p>
    </div>

    {large.map((project) => (
      <article class="project reveal" id={`project-${project.id}`}>
        <div>
          <div class="visual" aria-hidden="true">
            {project.metric ? (
              <>
                <div class="metric">{project.metric.value} <small>{t(project.metric.label, lang)}</small></div>
                <div class="bars"><i></i><i></i></div>
              </>
            ) : (
              <div class="flow">
                {project.stack.slice(0, 3).map((s, i) => (
                  <>{i > 0 && <span class="arrow">→</span>}<span class="node">{s}</span></>
                ))}
              </div>
            )}
          </div>
          <h3>{t(project.title, lang)}</h3>
          <p class="muted">{t(project.summary, lang)}</p>
          <div class="stack">
            {project.stack.join(' / ')} · {formatYM(project.period.start, lang).split(' ').pop()}
          </div>
        </div>
        <div class="project-body">
          <dl>
            <div><dt>{strings.storyProblem}</dt><dd>{t(project.story!.problem, lang)}</dd></div>
            <div><dt>{strings.storyDecision}</dt><dd>{t(project.story!.decision, lang)}</dd></div>
            <div><dt>{strings.storyEvidence}</dt><dd><strong>{t(project.story!.evidence, lang)}</strong></dd></div>
          </dl>
          {project.case_study && (
            <details>
              <summary>{strings.caseStudy}</summary>
              <div class="prose case-study" set:html={md(t(project.case_study, lang))} />
            </details>
          )}
          {project.links && Object.keys(project.links).length > 0 && (
            <div class="project-links">
              {Object.entries(project.links).map(([key, url]) => (
                <a href={url} target="_blank" rel="noopener">{linkLabel(key)} →</a>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}

    {compact.map((project) => (
      <article class="mini-project reveal" id={`project-${project.id}`}>
        <h3>{t(project.title, lang)}</h3>
        <p class="muted">{t(project.summary, lang)}</p>
        <div class="stack">{project.stack.join(' / ')}</div>
        {project.case_study && (
          <details>
            <summary>{strings.caseStudy}</summary>
            <div class="prose case-study" set:html={md(t(project.case_study, lang))} />
          </details>
        )}
        {project.links && Object.keys(project.links).length > 0 && (
          <div class="project-links">
            {Object.entries(project.links).map(([key, url]) => (
              <a href={url} target="_blank" rel="noopener">{linkLabel(key)} →</a>
            ))}
          </div>
        )}
      </article>
    ))}
  </section>
)}

<style>
  .project {
    display: grid;
    grid-template-columns: 36% 1fr;
    gap: 42px;
    padding: 34px 0;
    border-top: 1px solid var(--border);
  }
  .project:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .project h3 {
    font-size: 1.7rem;
    margin: 16px 0 12px;
  }
  .project p,
  .mini-project p {
    font-size: 0.94rem;
  }
  .visual {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-height: 176px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }
  .flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 7px;
    font-family: var(--mono);
    font-size: 0.68rem;
  }
  .flow .node {
    border: 1px solid var(--accent-dim);
    padding: 10px 7px;
    border-radius: 3px;
    background: var(--bg);
  }
  .flow .node:last-child {
    background: color-mix(in srgb, var(--accent) 18%, var(--bg));
  }
  .flow .arrow {
    color: var(--text-faint);
  }
  .metric {
    font-size: 2.6rem;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .metric small {
    font-size: 0.8rem;
    letter-spacing: 0;
    color: var(--text-dim);
  }
  .bars {
    display: flex;
    gap: 12px;
    align-items: end;
    height: 80px;
  }
  .bars i {
    display: block;
    width: 38%;
    height: 80px;
    background: var(--accent-dim);
  }
  .bars i:last-child {
    height: 10px;
    background: var(--accent);
  }
  .stack {
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1.8;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: 18px;
  }
  dl {
    display: grid;
    gap: 14px;
  }
  dt {
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 600;
  }
  dd {
    margin-top: 3px;
    font-size: 0.94rem;
    color: var(--text-dim);
  }
  dd strong {
    color: var(--text);
    font-weight: 600;
  }
  details {
    margin-top: 18px;
  }
  .case-study {
    margin-top: 10px;
    font-size: 0.92rem;
    color: var(--text-dim);
  }
  .project-links {
    display: flex;
    gap: 22px;
    font-size: 0.82rem;
    margin-top: 18px;
  }
  .mini-project {
    padding: 24px 0;
    border-top: 1px solid var(--border);
  }
  .mini-project h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .mini-project p {
    max-width: 700px;
  }
  .mini-project .stack {
    margin-top: 10px;
  }
  @media (max-width: 700px) {
    .project {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 28px 0;
    }
    .visual {
      min-height: 150px;
    }
  }
</style>
