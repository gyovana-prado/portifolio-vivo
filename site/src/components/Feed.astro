---
import type { Lang, FeedEntry, Project } from '../lib/content';
import { t, feedTitle } from '../lib/content';
import { ui, typeBadge } from '../lib/ui';
import { md } from '../lib/md';
import { formatDate } from '../lib/dates';

interface Props {
  lang: Lang;
  entries: FeedEntry[];
  projects?: Project[];
}

const { lang, entries, projects = [] } = Astro.props;
const strings = ui[lang];

// id → título do projeto, para o link "parte de <projeto>".
const projectTitle = new Map(projects.map((p) => [p.id, t(p.title, lang)]));

// Só oferecem filtro os tipos que realmente aparecem no feed (evita opção vazia),
// na ordem canônica dos badges.
const ORDER: FeedEntry['type'][] = ['decision', 'problem-solved', 'shipped', 'learning'];
const presentTypes = ORDER.filter((tp) => entries.some((e) => e.type === tp));

// Texto pesquisável de cada entrada, no idioma da página (busca no cliente).
function haystack(e: FeedEntry): string {
  return [feedTitle(e, lang), t(e.narrative, lang), t(e.technical, lang), e.tags.join(' ')]
    .join(' ')
    .toLowerCase();
}
---

<section id="feed">
  <div class="section-head reveal">
    <div>
      <div class="eyebrow">{strings.feedEyebrow}</div>
      <h2>{strings.feedTitle}</h2>
    </div>
    <p class="lede">{strings.feedLede}</p>
  </div>

  {entries.length === 0 ? (
    <p class="faint">{strings.feedEmpty}</p>
  ) : (
    <div class="feed-wrap" data-feed>
      <div class="log-controls">
        <input type="search" data-search placeholder={strings.searchPlaceholder} aria-label={strings.searchLabel} />
        {presentTypes.length > 1 && (
          <select data-type-filter aria-label={strings.filterLabel}>
            <option value="all">{strings.allTypes}</option>
            {presentTypes.map((tp) => <option value={tp}>{typeBadge[lang][tp]}</option>)}
          </select>
        )}
      </div>
      <p class="count" aria-live="polite" data-count data-of={strings.countOf} data-label={strings.countEntries}>
        {entries.length} {strings.countOf} {entries.length} {strings.countEntries}
      </p>

      <ol class="feed-list">
        {entries.map((entry) => (
          <li class="entry" id={`feed-${entry.id}`} data-type={entry.type} data-text={haystack(entry)}>
            <details>
              <summary>
                <span class="meta">
                  <time datetime={entry.date}>{formatDate(entry.date, lang)}</time>
                  <span class={`type ${entry.type}`}>{typeBadge[lang][entry.type]}</span>
                </span>
                <h3>{feedTitle(entry, lang)}</h3>
              </summary>
              <div class="entry-body">
                <p class="narrative">{t(entry.narrative, lang)}</p>
                {entry.outcome && (
                  <p class="outcome"><b>{strings.outcome}:</b> {t(entry.outcome, lang)}</p>
                )}
                <div class="prose technical">
                  <p class="technical-label">{strings.technicalDetail}</p>
                  <Fragment set:html={md(t(entry.technical, lang))} />
                </div>
                <div class="entry-foot">
                  <span class="tags">{entry.tags.join(' · ')}</span>
                  {entry.project && projectTitle.has(entry.project) && (
                    <a href={`#project-${entry.project}`}>{strings.partOf} {projectTitle.get(entry.project)}</a>
                  )}
                  <a class="permalink" href={`#feed-${entry.id}`}>#</a>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
      <p class="empty" data-empty hidden>{strings.noResults}</p>
    </div>
  )}
</section>

<script is:inline>
  (function () {
    function initFeed() {
      var wrap = document.querySelector('[data-feed]');
      if (!wrap || wrap.dataset.ready) return;
      wrap.dataset.ready = '1';
      var search = wrap.querySelector('[data-search]');
      var select = wrap.querySelector('[data-type-filter]');
      var count = wrap.querySelector('[data-count]');
      var empty = wrap.querySelector('[data-empty]');
      var entries = Array.prototype.slice.call(wrap.querySelectorAll('.entry'));

      function apply() {
        var q = (search.value || '').trim().toLowerCase();
        var tp = select ? select.value : 'all';
        var shown = 0;
        entries.forEach(function (e) {
          var ok = (tp === 'all' || e.dataset.type === tp) && (!q || e.dataset.text.indexOf(q) !== -1);
          e.hidden = !ok;
          if (ok) shown++;
        });
        count.textContent = shown + ' ' + count.dataset.of + ' ' + entries.length + ' ' + count.dataset.label;
        empty.hidden = shown !== 0;
      }
      search.addEventListener('input', apply);
      if (select) select.addEventListener('change', apply);

      // Permalink: abrir a entrada apontada pelo hash.
      function openFromHash() {
        if (location.hash.indexOf('#feed-') !== 0) return;
        var target = document.getElementById(location.hash.slice(1));
        if (target) target.querySelector('details').open = true;
      }
      window.addEventListener('hashchange', openFromHash);
      openFromHash();
    }
    document.addEventListener('astro:page-load', initFeed);
    if (document.readyState !== 'loading') initFeed();
    else document.addEventListener('DOMContentLoaded', initFeed);
  })();
</script>

<style>
  .log-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
  }
  .log-controls input {
    flex: 1;
    min-width: 0;
  }
  .log-controls input,
  .log-controls select {
    font: inherit;
    font-size: 0.875rem;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 11px 13px;
  }
  .log-controls select {
    background: var(--bg);
  }
  .count {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    margin-bottom: 14px;
  }
  .feed-list {
    list-style: none;
  }
  .entry {
    border-top: 1px solid var(--border);
    padding: 20px 0;
  }
  .entry[hidden] {
    display: none;
  }
  .entry summary {
    display: grid;
    grid-template-columns: 120px 1fr 20px;
    gap: 22px;
    align-items: center;
    color: var(--text);
    font-size: 1rem;
  }
  /* The global caret is replaced by a +/− on the right. */
  .entry summary::before {
    content: none;
  }
  .entry summary::after {
    content: '+';
    font-size: 1.4rem;
    line-height: 1;
    color: var(--accent);
    justify-self: end;
  }
  .entry details[open] summary::after {
    content: '−';
  }
  .meta {
    display: flex;
    flex-direction: column;
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1.7;
    color: var(--text-faint);
  }
  .type.decision { color: var(--t-decision); }
  .type.problem-solved { color: var(--t-problem-solved); }
  .type.shipped { color: var(--t-shipped); }
  .type.learning { color: var(--t-learning); }
  .entry h3 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }
  .entry summary:hover h3 {
    color: var(--accent);
  }
  .entry-body {
    padding: 18px 42px 0 142px;
    max-width: 900px;
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .entry-body > * + * {
    margin-top: 14px;
  }
  .outcome b {
    color: var(--text);
  }
  .technical {
    border-left: 2px solid var(--border);
    padding-left: 14px;
  }
  .technical-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }
  .entry-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: baseline;
    font-size: 0.8rem;
  }
  .tags {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }
  .permalink {
    margin-left: auto;
    color: var(--text-faint);
  }
  .empty {
    padding: 26px 0;
    color: var(--text-dim);
  }
  @media (max-width: 700px) {
    .log-controls {
      flex-wrap: wrap;
    }
    .log-controls input {
      flex-basis: 100%;
    }
    .entry summary {
      grid-template-columns: 1fr 22px;
      gap: 6px;
    }
    .meta {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 12px;
    }
    .entry h3 {
      font-size: 1.15rem;
    }
    .entry-body {
      padding: 16px 0 0;
    }
  }
</style>
